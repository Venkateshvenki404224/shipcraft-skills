{
  "project": "Acme",
  "base": "main",
  "branch_prefix": "agent/",
  "rules": ["CLAUDE.md"],
  "review_rules": ".work-profile/review-rules.md",
  "secrets": [".env*", "tests/e2e/.auth/*"],

  "app": {
    "url": "http://localhost:3000",
    "check": "curl -sk -o /dev/null -w '%{http_code}' http://localhost:3000/login",
    "expect": "200",
    "start": "docker compose up -d",
    "start_minutes": 3,
    "login": "npx playwright test --project=setup",
    "auth": "tests/e2e/.auth/{role}.json",
    "fixtures": "npm run seed:test"
  },
  "roles": ["admin", "user", "signed-out"],

  "gate": ["npm run lint", "npm run typecheck", "npm test"],
  "evals": { "cmd": "make eval", "paths": ["evals/", "src/ai/"] },
  "e2e": {
    "dir": "tests/e2e",
    "cmd": "cd tests/e2e && npx playwright test {specs} --retries=0",
    "full": "cd tests/e2e && npx playwright test",
    "browsers": ["chromium", "firefox", "webkit"]
  },
  "ui_snap": { "dir": "tests/e2e/ui-snap", "theme_key": null, "hide": [".cookie-banner"], "channel": null },
  "video": true,
  "feature_map": "docs/features.md",

  "team": {
    "stack": "Next.js",
    "business": "Acme sells a scheduling app to small clinics, monthly plans",
    "design_system": ["src/components/ui", "src/styles"],
    "pm": true, "ceo": true, "design": true, "senior": true
  },
  "autonomy": "owner",

  "host": "claude",
  "available_models": ["<written by scripts/detect_models.py>"],
  "model_fallback": "<one of available_models: used by any role with no model>",
  "models": { "plan": "<model>", "approve": "<model>", "research": "<model>", "work": "<model>",
              "pm": "<model, optional>", "ceo": "<optional>", "design": "<optional>", "senior": "<optional>", "verify": "<optional>", "cheap": "<optional: gate runs, red runs, UI snaps, scope>" },
  "ship": { "mode": "pr", "auto_push": false }
}
