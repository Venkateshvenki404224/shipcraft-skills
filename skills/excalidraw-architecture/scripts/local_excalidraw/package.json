{
  "name": "local-excalidraw-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --outfile=dist/bundle.js --format=esm --jsx=automatic --conditions=production --loader:.woff2=file --loader:.woff=file --loader:.ttf=file --define:process.env.NODE_ENV='\"production\"' --define:process.env.IS_PREACT='\"false\"' --minify && cp -r node_modules/@excalidraw/excalidraw/dist/prod/fonts dist/ 2>/dev/null || true"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.24.2"
  }
}
